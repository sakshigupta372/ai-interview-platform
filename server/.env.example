MONGO_URI=mongodb://127.0.0.1:27017/ai-interview-platform
PORT=5000
FRONTEND_URL=http://localhost:3000

# Required: Clerk secret key (same app as the frontend). Used to verify the
# session token on every authenticated request. Without it, those routes return 503.
CLERK_SECRET_KEY=sk_test_...

# Optional: platform Gemini key. New users get FREE_INTERVIEW_LIMIT interviews
# on it (default 3) without entering their own key. Users who add their own key
# are unlimited. Mentor / coach / prep always need the user's own key.
# GEMINI_API_KEY=AIzaSy...
# FREE_INTERVIEW_LIMIT=3

# Optional: extra allowed browser origins, comma-separated (custom domain, previews).
# ALLOWED_ORIGINS=https://my-preview.vercel.app

# Production (Render) - use MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ai-interview-platform?retryWrites=true&w=majority
# FRONTEND_URL=https://ai-interview-platform-nr7v.vercel.app
